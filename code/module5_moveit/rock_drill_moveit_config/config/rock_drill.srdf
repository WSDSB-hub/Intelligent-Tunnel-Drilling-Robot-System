<?xml version="1.0"?>
<robot name="rock_drill">
    <!-- 规划组定义 -->
    <group name="arm_group">
        <chain base_link="base_link" tip_link="drill_tip_link"/>
    </group>

    <!-- 关节默认状态 -->
    <group_state name="home" group="arm_group">
        <joint name="base_pitch_joint" value="0.698"/>
        <joint name="boom_pitch_joint" value="0.698"/>
        <joint name="swing_joint" value="0"/>
        <joint name="feed_rot_joint" value="0"/>
        <joint name="feed_prismatic_joint" value="0.0"/>
    </group_state>

    <!-- 端部执行器（无） -->
    <end_effector name="none" group="arm_group"/>

    <!-- 允许碰撞的矩阵（初始为空，后续可调） -->
    <disable_collisions link1="base_link" link2="turret_link" reason="Adjacent"/>
    <disable_collisions link1="turret_link" link2="boom_link" reason="Adjacent"/>
    <disable_collisions link1="boom_link" link2="arm_link" reason="Adjacent"/>
    <disable_collisions link1="arm_link" link2="feed_rot_link" reason="Adjacent"/>
    <disable_collisions link1="feed_rot_link" link2="drill_tip_link" reason="Adjacent"/>
</robot>
