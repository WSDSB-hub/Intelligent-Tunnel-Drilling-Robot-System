<?xml version="1.0"?>
<robot name="rock_drill" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 基础连杆（台车底座） -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="1.0 1.0 0.5"/>
      </geometry>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="1.0 1.0 0.5"/>
      </geometry>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="5000"/>
      <origin xyz="0 0 0.25"/>
      <inertia ixx="500" ixy="0" ixz="0" iyy="500" iyz="0" izz="500"/>
    </inertial>
  </link>

  <!-- 基座俯仰关节（关节1） -->
  <joint name="base_pitch_joint" type="revolute">
    <parent link="base_link"/>
    <child link="turret_link"/>
    <origin xyz="0 0 2.7" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="1.396" effort="10000" velocity="0.5"/>
    <!-- 0°到80°转为弧度 -->
  </joint>

  <link name="turret_link">
    <visual>
      <geometry>
        <cylinder length="0.5" radius="0.3"/>
      </geometry>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <material name="dark_gray">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.5" radius="0.3"/>
      </geometry>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="200"/>
      <origin xyz="0 0 0.25"/>
      <inertia ixx="10" ixy="0" ixz="0" iyy="10" iyz="0" izz="10"/>
    </inertial>
  </link>

  <!-- 大臂俯仰关节（关节2） -->
  <joint name="boom_pitch_joint" type="revolute">
    <parent link="turret_link"/>
    <child link="boom_link"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="1.396" effort="10000" velocity="0.5"/>
  </joint>

  <link name="boom_link">
    <visual>
      <geometry>
        <cylinder length="5.028" radius="0.2"/>
      </geometry>
      <origin xyz="2.514 0 0" rpy="0 1.5708 0"/>
      <material name="yellow">
        <color rgba="0.8 0.8 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="5.028" radius="0.2"/>
      </geometry>
      <origin xyz="2.514 0 0" rpy="0 1.5708 0"/>
    </collision>
    <inertial>
      <mass value="500"/>
      <origin xyz="2.514 0 0"/>
      <inertia ixx="100" ixy="0" ixz="0" iyy="100" iyz="0" izz="100"/>
    </inertial>
  </link>

  <!-- 左右旋转关节（关节3） -->
  <joint name="swing_joint" type="revolute">
    <parent link="boom_link"/>
    <child link="arm_link"/>
    <origin xyz="5.028 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785" upper="0.785" effort="5000" velocity="0.5"/>
    <!-- ±45° -->
  </joint>

  <link name="arm_link">
    <visual>
      <geometry>
        <cylinder length="0.5" radius="0.15"/>
      </geometry>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.5" radius="0.15"/>
      </geometry>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="100"/>
      <origin xyz="0 0 0.25"/>
      <inertia ixx="5" ixy="0" ixz="0" iyy="5" iyz="0" izz="5"/>
    </inertial>
  </link>

  <!-- 推进梁旋转关节（关节4） -->
  <joint name="feed_rot_joint" type="revolute">
    <parent link="arm_link"/>
    <child link="feed_rot_link"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-6.283" upper="6.283" effort="5000" velocity="1.0"/>
    <!-- 360°旋转 -->
  </joint>

  <link name="feed_rot_link">
    <visual>
      <geometry>
        <sphere radius="0.2"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="50"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
  </link>

  <!-- 推进梁移动关节（关节5，棱柱关节） -->
  <joint name="feed_prismatic_joint" type="prismatic">
    <parent link="feed_rot_link"/>
    <child link="drill_tip_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="3.5" effort="5000" velocity="0.3"/>
  </joint>

  <!-- 钻头末端（工具点） -->
  <link name="drill_tip_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.05"/>
      </geometry>
      <origin xyz="0.05 0 0" rpy="0 1.5708 0"/>
      <material name="red">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.05"/>
      </geometry>
      <origin xyz="0.05 0 0" rpy="0 1.5708 0"/>
    </collision>
    <inertial>
      <mass value="5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

</robot>
